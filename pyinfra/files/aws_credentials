# localstack's well-known dummy credentials, which are not secret.
#
# The adamhl8 profile is deliberately absent: it authenticates via SSO (see aws_config) and
# holds no static key material. `aws sso login --profile adamhl8` mints its session, and that
# needs a browser, so it is not something pyinfra can do.
[localstack]
aws_access_key_id = test
aws_secret_access_key = test
